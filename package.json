    "test:watch": "vitest",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
