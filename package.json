{
  "name": "no-matts-sky",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A real-scale, real-physics, procedurally-generated space exploration game. Vertical slice (Milestone 0).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
